{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Scytale Passbook",
    "version": "0.1.0",
    "identifier": "com.myratu.scytale.passbook",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Scytale Passbook",
                "width": 1440,
                "height": 960,
                "minWidth": 1024,
                "minHeight": 720,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage"
        ],
        "icon": [
            "icons/icon.png",
            "icons/scytale-passbook.png"
        ]
    }
}